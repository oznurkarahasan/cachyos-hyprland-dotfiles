{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 4,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": ["custom/search", "custom/notification","custom/wallpaper", "hyprland/workspaces"],
    "modules-center": ["clock", "custom/weather"],
    "modules-right": ["hyprland/language", "network", "bluetooth", "pulseaudio", "backlight", "battery", "custom/power"],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": {
        "*": [1, 2, 3, 4]
        }
    },

    "clock": {
        "format": "  {:%H:%M:%S}",
        "format-alt": "  {:%d %b %Y}",
        "interval": 1,
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "custom/weather": {
        "format": "{}",
        "interval": 1800,
        "exec": "curl -s 'https://wttr.in/Zonguldak?format=%c+%t' 2>/dev/null || echo '  N/A'",
        "tooltip": true,
        "tooltip-format": "{}",
        "exec-if": "ping -c1 wttr.in -W2 2>/dev/null"
    },
    
    "custom/wallpaper": {
    "format": "󰋩",
    "on-click": "~/.config/waybar/scripts/wallpaper-picker.sh",
    "tooltip": false
    },

    "custom/search": {
    "format": "󰍉",
    "on-click": "wofi --show drun",
    "tooltip": false
    },

    "custom/notification": {
        "format": "󰂚",
        "on-click": "dunstctl history-pop",
        "on-right-click": "dunstctl close-all",
        "tooltip": false
    },

    "hyprland/language": {
        "format": "  {}",
        "format-en": "EN",
        "format-tr": "TR"
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤭 ",
        "tooltip-format": "{ifname}: {ipaddr} | {signalStrength}%",
        "on-click": "kitty -e nmtui"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱 {device_alias}",
        "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n{device_enumerate}",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰌶", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"]
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout",
        "tooltip": false
    }
}
